{
  "name": "@glossic/adapter-treesitter",
  "version": "0.1.0",
  "description": "Tree-sitter based extraction adapter for glossic",
  "keywords": [
    "documentation",
    "docs",
    "docs-as-code",
    "glossic",
    "adapter",
    "tree-sitter",
    "symbols"
  ],
  "license": "MIT",
  "author": "Rody Huancas",
  "homepage": "https://github.com/rody-huancas/glosik#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rody-huancas/glosik.git",
    "directory": "packages/adapters/treesitter"
  },
  "bugs": {
    "url": "https://github.com/rody-huancas/glosik/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glossic/schema": "workspace:*"
  }
}
