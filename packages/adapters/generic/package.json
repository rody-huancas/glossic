{
  "name": "@glossic/adapter-generic",
  "version": "0.3.0",
  "description": "Language-agnostic fallback adapter for glossic",
  "keywords": [
    "documentation",
    "docs",
    "docs-as-code",
    "glossic",
    "adapter",
    "static-analysis",
    "language-agnostic"
  ],
  "license": "MIT",
  "author": "Rody Huancas",
  "homepage": "https://github.com/rody-huancas/glossic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rody-huancas/glossic.git",
    "directory": "packages/adapters/generic"
  },
  "bugs": {
    "url": "https://github.com/rody-huancas/glossic/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glossic/schema": "workspace:*",
    "ignore": "^7.0.5",
    "picomatch": "^4.0.3",
    "tinyglobby": "^0.2.15"
  }
}
