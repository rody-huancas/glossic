{
  "name": "@glossic/provider-anthropic",
  "version": "0.1.0",
  "description": "Completion provider backed by the Anthropic API",
  "keywords": [
    "documentation",
    "docs",
    "docs-as-code",
    "glossic",
    "provider",
    "anthropic",
    "claude",
    "llm"
  ],
  "license": "MIT",
  "author": "Rody Huancas",
  "homepage": "https://github.com/rody-huancas/glosik#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rody-huancas/glosik.git",
    "directory": "packages/providers/anthropic"
  },
  "bugs": {
    "url": "https://github.com/rody-huancas/glosik/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@glossic/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
