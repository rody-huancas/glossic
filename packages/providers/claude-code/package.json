{
  "name": "@glossic/provider-claude-code",
  "version": "0.5.0",
  "description": "Completion provider backed by the Claude Code CLI",
  "keywords": [
    "documentation",
    "docs",
    "docs-as-code",
    "glossic",
    "provider",
    "claude-code",
    "claude",
    "llm"
  ],
  "license": "MIT",
  "author": "Rody Huancas",
  "homepage": "https://github.com/rody-huancas/glossic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rody-huancas/glossic.git",
    "directory": "packages/providers/claude-code"
  },
  "bugs": {
    "url": "https://github.com/rody-huancas/glossic/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glossic/schema": "workspace:*"
  }
}
