{
  "name": "glossic",
  "version": "0.0.0",
  "description": "Generate documentation from your codebase and fail CI when the two drift apart",
  "keywords": [
    "documentation",
    "docs",
    "docs-as-code",
    "glossic",
    "cli",
    "documentation-generator",
    "llm",
    "ai",
    "static-analysis",
    "monorepo",
    "claude",
    "anthropic"
  ],
  "license": "MIT",
  "author": "Rody Huancas",
  "homepage": "https://github.com/rody-huancas/glosik#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rody-huancas/glosik.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/rody-huancas/glosik/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "glossic": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/index.js",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md','README.md')\""
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@glossic/adapter-generic": "workspace:*",
    "@glossic/adapter-nestjs": "workspace:*",
    "@glossic/adapter-treesitter": "workspace:*",
    "@glossic/core": "workspace:*",
    "@glossic/provider-anthropic": "workspace:*",
    "@glossic/provider-claude-code": "workspace:*",
    "@glossic/schema": "workspace:*",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
