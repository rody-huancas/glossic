{
  "name": "glossic",
  "version": "0.2.0",
  "description": "Generate documentation from your codebase and fail CI when the two drift apart",
  "keywords": [
    "documentation",
    "docs",
    "docs-as-code",
    "glossic",
    "cli",
    "documentation-generator",
    "llm",
    "ai",
    "static-analysis",
    "monorepo",
    "claude",
    "anthropic"
  ],
  "license": "MIT",
  "author": "Rody Huancas",
  "homepage": "https://github.com/rody-huancas/glossic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rody-huancas/glossic.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/rody-huancas/glossic/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "glossic": "./dist/index.js"
  },
  "scripts": {
    "preinstall": "node -e \"if(+process.versions.node.split('.')[0]<20){console.error('\\n  glossic requires Node >= 20. You are running '+process.version+'.\\n  Upgrade Node and install again: https://nodejs.org\\n');process.exit(1)}\"",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/index.js",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md','README.md')\""
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@glossic/adapter-generic": "workspace:*",
    "@glossic/adapter-nestjs": "workspace:*",
    "@glossic/adapter-treesitter": "workspace:*",
    "@glossic/core": "workspace:*",
    "@glossic/provider-anthropic": "workspace:*",
    "@glossic/provider-claude-code": "workspace:*",
    "@glossic/schema": "workspace:*",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  }
}
