{
  "name": "@glossic/core",
  "version": "0.1.0",
  "description": "Glossic orchestration core: registries, pipeline and manifest plumbing",
  "keywords": [
    "documentation",
    "docs",
    "docs-as-code",
    "glossic",
    "orchestration",
    "pipeline",
    "manifest",
    "incremental",
    "cache"
  ],
  "license": "MIT",
  "author": "Rody Huancas",
  "homepage": "https://github.com/rody-huancas/glosik#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rody-huancas/glosik.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/rody-huancas/glosik/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glossic/schema": "workspace:*",
    "jiti": "^2.6.1",
    "picomatch": "^4.0.3",
    "tinyglobby": "^0.2.15",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  }
}
