{
  "name": "glossic-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Glossic monorepo root",
  "license": "MIT",
  "author": "Rody Huancas",
  "homepage": "https://github.com/rody-huancas/glossic#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rody-huancas/glossic.git"
  },
  "bugs": {
    "url": "https://github.com/rody-huancas/glossic/issues"
  },
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "clean": "pnpm -r exec rm -rf dist",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.15.3",
    "@types/picomatch": "^4.0.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
